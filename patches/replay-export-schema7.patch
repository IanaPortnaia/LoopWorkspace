+        cappedCapture["captureOmittedReason"] = "replayCaptureExceededUploadSizeLimit"
+        cappedCapture["originalReplayCaptureBytes"] = fullBytes
+        cappedCapture["replayCaptureMaxBytes"] = replayCaptureTestingDetailsMaxBytes
+
+        for section in replayCaptureOptionalSectionsBySizeRisk where cappedCapture[section] != nil {
+            cappedCapture.removeValue(forKey: section)
+            omittedSections.append(section)
+            cappedCapture["omittedReplayCaptureSections"] = omittedSections
+
+            let cappedDetails = ["replayCapture": cappedCapture]
+            if let cappedBytes = replayCaptureJSONSize(cappedDetails),
+               cappedBytes <= replayCaptureTestingDetailsMaxBytes {
+                cappedCapture["replayCaptureBytesAfterOmission"] = cappedBytes
+                return ["replayCapture": cappedCapture]
+            }
+        }
+
+        var minimalCapture = [String: Any]()
+        for key in replayCapturePreservedKeys {
+            if let value = capture[key] {
+                minimalCapture[key] = value
+            }
+        }
+
+        minimalCapture["schemaVersion"] = capture["schemaVersion"] ?? replayCaptureSchemaVersion
+        minimalCapture["captureRole"] = capture["captureRole"] ?? "completedLoopDecision"
